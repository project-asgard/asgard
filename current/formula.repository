\_form#0=170x55:\[ \frac{\partial}{\partial t} f + \nabla \cdot f = s \]
\_form#1=268x28:\[ (x, y) \in (-1, 1) \otimes (-2, 2) \]
\_form#2=378x28:\[ f(t, x, y) = \sin(2 t) \cos(\pi x) \sin(2 \pi y) \]
\_form#3=168x55:\[ \frac{\partial}{\partial t} f + \frac{\partial}{\partial x} f = s \]
\_form#4=150x28:\[ (-\pi N_w, \pi N_w) \]
\_form#5=230x28:\[ f(t, x) = \cos(t) \sin(x) \]
\_form#6=408x80:\[ f(t, x_1, x_2, \cdots, x_d) = \cos(t) \prod_{j=1}^d \sin(x_j) \]
\_form#7=195x55:\[ \frac{\partial}{\partial t} f - \nabla \cdot \nabla f = s \]
\_form#8=463x33:\[ f(t, x, y) = (1 - \exp(-t)) (\exp(1 - x^2) - 1) \]
\_form#9=310x55:\[ \frac{d}{dt} f - \nabla \cdot g = s, \qquad g = \nabla f \]
\_form#10=123x58:\[ -\frac{d^2}{d x^2} f = 2 \]
\_form#11=163x33:\[ f(x) = 2 x - x^2 \]
\_form#12=275x55:\[ \frac{d}{dx} f(0) = 2, \qquad f(1) = 1 \]
\_form#13=178x58:\[ -\frac{d^2}{d x^2} f = \cos(x) \]
\_form#14=148x28:\[ f(x) = \cos(x) \]
\_form#15=155x55:\[ \frac{d}{dx} f + R f = 0 \]
\_form#16=418x63:\[ R_{left} = \frac{ \sin(-0.5) }{ \cos(-0.5) } \qquad R_{right} = \frac{ \sin(2) }{ \cos(2) } \]
\_form#17=575x63:\[ \frac{\partial}{\partial t} f -
   \frac{1}{r^2} \frac{\partial}{\partial r} \left( r^2 \frac{\partial f }{\partial r} \right)
   - \frac{1}{r^2 \sin(\theta)} \frac{\partial}{\partial \theta}
   \left( \sin(\theta) \frac{\partial f}{\partial \theta} \right) = s \]
\_form#18=355x28:\[ f(t, r, \theta) = \exp(-t) r \cos(r) \cos(\theta) \]
\_form#19=170x55:\[ \frac{\partial}{\partial t} f +  \frac{\partial}{\partial x} f = 0 \]
\_form#20=383x28:\[ f(x, 0) = 0, \qquad f(0, t) = \sin(-2 \pi t) \]
\_form#21=580x55:\[ \frac{\partial}{\partial t} f(x, v) + v \cdot \nabla_x f(x, v, t) + E(x, t) \nabla_v \cdot f(x, v, t) = 0 \]
\_form#22=648x60:\[ E(x,t) = -\nabla_x \Phi(x, t), \qquad - \nabla_x \cdot \nabla_x \Phi(x, t) = \int_v f(x, v, t) dv \]
\_form#23=720x55:\[ \frac{\partial}{\partial t} f(x, v, t) + v \nabla_x f(x, v, t) + E(x, t) \cdot \nabla_v f(x, v, t) =
 \mathcal{C}_{LB}[f](x, v, t) \]
\_form#24=473x55:\[ \frac{\partial}{\partial t} f(x, v, t) + v \nabla_x f(x, v, t) =
 \mathcal{C}_{LB}[f](x, v, t) \]
\_form#25=225x55:\[ \frac{d}{d t} f + f \cdot \nabla f = \nu \Delta f \]
\_form#26=320x55:\[ \frac{d}{d t} f + \frac{1}{2} \nabla \cdot f^2 - \nu \nabla \cdot \nabla f = 0 \]
\_form#27=353x28:\[ \mathcal{C}_{sBGK}[f](x, v, t) = \nu ( M(f) - f) \]
\_form#28=478x68:\[ M(f)(x, v) = \frac{n(x)}{\sqrt{2\pi \theta(x)}} \exp \left( - \frac{|v - u(x)|^2}{2 \theta(x)} \right) \]
\_form#29=688x60:\[ n(x) = \int_v f dv, \qquad u(x) = (u_1, u_2, u_3), \quad u_i(x) = \frac{1}{n(x)} \int_v v_i f dv \]
\_form#30=393x60:\[ \theta(x) = \frac{1}{3 n(x)} \int_v |v|^2 f dv - \frac{1}{3} \| u(x) \|^2  \]
\_form#31=748x55:\[ \frac{\partial}{\partial t} f(x, v, t) + v \nabla_x f(x, v, t) + E(x, t) \cdot \nabla_v f(x, v, t) =
 \mathcal{C}_{sBGK}[f](x, v, t) \]
\_form#32=463x55:\[ \frac{\partial}{\partial t} f(x, v, t) + v \nabla_x f(x, v, t) = \nu ( M(f) - f) \]
