#include "asgard.hpp"

inline void show_cmake_log(){
std::cout << "\nASGarD CMake parameters:\n";

std::cout << R"CMAKEVARS(
CMAKE_COMMAND                      @CMAKE_COMMAND@
CMAKE_BUILD_TYPE                   @CMAKE_BUILD_TYPE@
CMAKE_INSTALL_PREFIX               @CMAKE_INSTALL_PREFIX@
CMAKE_CXX_FLAGS                    @CMAKE_CXX_FLAGS@
CMAKE_CXX_FLAGS_DEBUG              @CMAKE_CXX_FLAGS_DEBUG@
CMAKE_CXX_FLAGS_RELEASE            @CMAKE_CXX_FLAGS_RELEASE@
CMAKE_CXX_COMPILER                 @CMAKE_CXX_COMPILER@
BUILD_SHARED_LIBS                  @BUILD_SHARED_LIBS@
BLAS_LIBRARIES                     @BLAS_LIBRARIES@
LAPACK_LIBRARIES                   @LAPACK_LIBRARIES@
)CMAKEVARS";

#ifdef ASGARD_USE_OPENMP
std::cout << R"OMPVARS(
OpenMP_CXX_LIBRARIES               @OpenMP_CXX_LIBRARIES@
OpenMP_CXX_FLAGS                   @OpenMP_CXX_FLAGS@
)OMPVARS";
#endif

#ifdef ASGARD_USE_CUDA
std::cout << R"CUDAVARS(
CMAKE_CUDA_COMPILER                @CMAKE_CUDA_COMPILER@
CMAKE_CUDA_ARCHITECTURES           @CMAKE_CUDA_ARCHITECTURES@
CMAKE_CUDA_FLAGS                   @CMAKE_CUDA_FLAGS@
CMAKE_CUDA_FLAGS_DEBUG             @CMAKE_CUDA_FLAGS_DEBUG@
CMAKE_CUDA_FLAGS_RELEASE           @CMAKE_CUDA_FLAGS_RELEASE@
)CUDAVARS";
#endif

#ifdef ASGARD_USE_ROCM
std::cout << R"ROCMVARS(
CMAKE_HIP_COMPILER                @CMAKE_HIP_COMPILER@
CMAKE_HIP_ARCHITECTURES           @CMAKE_HIP_ARCHITECTURES@
CMAKE_HIP_FLAGS                   @CMAKE_HIP_FLAGS@
CMAKE_HIP_FLAGS_DEBUG             @CMAKE_HIP_FLAGS_DEBUG@
CMAKE_HIP_FLAGS_RELEASE           @CMAKE_HIP_FLAGS_RELEASE@
)ROCMVARS";
#endif

#ifdef ASGARD_USE_MPI
std::cout << R"MPIVARS(
MPI_CXX_LIBRARIES                  @MPI_CXX_LIBRARIES@
MPI_CXX_INCLUDE_PATH               @MPI_CXX_INCLUDE_PATH@
MPI_CXX_COMPILE_FLAGS              @MPI_CXX_COMPILE_FLAGS@
MPI_CXX_LINK_FLAGS                 @MPI_CXX_LINK_FLAGS@
)MPIVARS";
#endif

std::cout << R"ASGARDVARS(
ASGARD_PRECISIONS                  @ASGARD_PRECISIONS@
ASGARD_USE_OPENMP                  @ASGARD_USE_OPENMP@
ASGARD_USE_MPI                     @ASGARD_USE_MPI@
ASGARD_USE_CUDA                    @ASGARD_USE_CUDA@
ASGARD_USE_ROCM                    @ASGARD_USE_ROCM@
ASGARD_USE_PYTHON                  @ASGARD_USE_PYTHON@
ASGARD_USE_HIGHFIVE                @ASGARD_USE_HIGHFIVE@
ASGARD_USE_FLOPCOUNTER             @ASGARD_USE_FLOPCOUNTER@
)ASGARDVARS";

std::cout << std::endl;
}
